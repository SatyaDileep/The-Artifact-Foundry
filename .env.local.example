# ---- App (Vercel: set in Project → Settings → Environment Variables) ----

# Supabase project URL and public anon key (Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-side service role key (never expose to the browser)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Comma-separated emails allowed to manage the library (curator access)
ADMIN_EMAILS=you@example.com

# Public site URL — used by sitemap, robots, and auth redirects
NEXT_PUBLIC_SITE_URL=https://your-domain.vercel.app

# Set to "true" only for local development without a database
NEXT_PUBLIC_DEMO_MODE=false

# ---- Edge functions (Supabase: supabase secrets set ...) ----

# Groq API key used by generate-artifact and ask
GROQ_API_KEY=your-groq-key
# Optional: override the Groq model (default llama-3.3-70b-versatile)
GROQ_MODEL=llama-3.3-70b-versatile

# Supadata API key for auto-fetching YouTube transcripts
SUPADATA_API_KEY=your-supadata-key

# Embeddings need no key: the edge functions use Supabase's free built-in
# gte-small model (384 dims) via Supabase.ai.Session.
